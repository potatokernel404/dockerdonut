{
  "name": "dockerdonut",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @dockerdonut/web\" \"npm run dev --workspace @dockerdonut/api\"",
    "dev:web": "npm run dev --workspace @dockerdonut/web",
    "dev:api": "npm run dev --workspace @dockerdonut/api",
    "build": "npm run build --workspace @dockerdonut/web && npm run build --workspace @dockerdonut/api",
    "start:web": "npm run start --workspace @dockerdonut/web",
    "start:api": "npm run start --workspace @dockerdonut/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
